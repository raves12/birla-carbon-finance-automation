    <sys_ui_action action="INSERT_OR_UPDATE">
        <action_name>check_sap_draft_status_payment</action_name>
        <active>true</active>
        <client>false</client>
        <client_script_v2/>
        <comments/>
        <condition>current.state == 'SAP_DRAFT'</condition>
        <form_action>true</form_action>
        <form_button>true</form_button>
